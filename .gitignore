# Env
.env
.env.test

# Pack output
*.tgz
.yarn-integrity


# Compiled output next to sources (lib/ is the only publishable JS output;
# declarations belong in lib/ and the tutorial build cache in .tsc/)
/packages/ihsm/src/**/*.js
/packages/ihsm/src/**/*.d.ts
/tutorials/**/*.js
/tutorials/**/*.d.ts
**.map

# Nix build symlinks (nix build -o result, result-2, …)
/result
/result-*
result*/
**/result*/

# Docusaurus — generated site (sources: packages/ihsm/website/docs-src/, …)
/packages/ihsm/docs-build/
/packages/ihsm/website/docs/
/packages/ihsm/website/.docs-staging/
/packages/ihsm/website/.docusaurus/
/packages/ihsm/website/sidebars.ts
/packages/ihsm/website/static/img/plantuml/

# @ihsm/otel Docusaurus (sources: packages/otel/website/docs-src/)
/packages/otel/docs-build/
/packages/otel/website/docs/
/packages/otel/website/.docusaurus/

# IDE — .vscode/ is committed; ignore other local editor files
.idea/
*.code-workspace

