report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime ctx
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output
lib-cov

# Dependencies (also ignore the Nix store symlink, not just real dirs)
/node_modules
node_modules/
packages/ihsm/node_modules/
node_modules.bak/
jspm_packages/

# TypeScript — compiled library + project-reference cache (never commit)
/packages/ihsm/lib/
/packages/ihsm/.tsc/
/packages/tools/lib/
/packages/tools/.tsc/
/packages/tools/output/
/packages/tools/node_modules/
*.tsbuildinfo
.t

# Caches
.npm
.eslintcache
.cache
.grunt
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
