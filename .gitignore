# Logs
logs
*.traceWriter
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime ctx
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output
lib-cov

# Dependencies
node_modules/
node_modules.bak/
jspm_packages/

# TypeScript — compiled library + project-reference cache (never commit)
/lib/
/.tsc/
*.tsbuildinfo
.t

# Caches
.npm
.eslintcache
.cache
.grunt
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.fusebox/
.serverless/
.dynamodb/
.node_repl_history

# Env
.env
.env.test

# Pack output
*.tgz
.yarn-integrity


# Compiled JS next to sources (lib/ is the only publishable JS output)
/src/**/*.js
**.map

# Nix build symlinks (nix build -o result, result-2, …)
result*/
**/result*/

# Docusaurus — generated site (sources: website/docs-src/, tutorials/, reference/)
/docs-build/
/website/docs/
/website/.docusaurus/
/website/sidebars.ts
/website/static/img/plantuml/

# IDE — .vscode/ is committed; ignore other local editor files
.idea/
*.code-workspace

# Misc
*.tmp.txt
.npmtoken
