{
	"extends": "@docusaurus/tsconfig",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@site/*": ["./src/*"],
			"@ihsm/*": ["../../src/*"],
			"@tutorials/*": ["../*"]
		}
	},
	"include": [
		"src/**/*",
		"docusaurus.config.ts",
		"sidebars.ts",
		"../**/machine.ts",
		"../**/interactive.ts",
		"../**/trace-*.ts",
		"../_shared/interactive-helpers.ts",
		"../_shared/interactive-types.ts",
		"../_shared/trace.ts",
		"../../src/index.ts",
		"../../src/internal/**/*.ts"
	],
	"exclude": ["../**/tutorial.spec.ts", "../_shared/interactive.spec.ts"]
}
