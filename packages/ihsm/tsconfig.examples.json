{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": false,
		"outDir": "./.tsc/examples",
		"rootDir": ".",
		"tsBuildInfoFile": "./.tsc/examples.tsbuildinfo",
		"module": "node16",
		"moduleResolution": "node16",
		"types": ["mocha", "node"]
	},
	"include": [
		"examples/**/machine.ts",
		"examples/**/interactive.ts",
		"examples/**/trace-*.ts",
		"examples/shared/trace.ts",
		"examples/shared/playground-top.ts",
		"examples/shared/interactive-helpers.ts",
		"examples/shared/interactive-types.ts",
		"examples/shared/state-names.ts"
	],
	"references": [{ "path": "./tsconfig.lib.json" }]
}
