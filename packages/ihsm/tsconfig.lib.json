{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"outDir": "./lib/cjs",
		"rootDir": "./src",
		"tsBuildInfoFile": "./.tsc/cjs.tsbuildinfo",
		"module": "node16",
		"moduleResolution": "node16",
		"lib": ["ES2022"],
		"types": ["node"],
		"allowJs": false
	},
	"include": ["src/**/*"],
	"exclude": ["src/spec", "src/test-only"]
}
