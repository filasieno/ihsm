{
	"diff": true,
	"extension": ["ts"],
	"require": ["ts-node/register/transpile-only"],
	"node-option": ["no-experimental-strip-types"],
	"spec": ["src/spec/**/*.spec.ts"],
	"package": "./package.json",
	"reporter": "spec",
	"slow": 75,
	"timeout": 2000,
	"ui": "bdd",
	"recursive": true,
	"watch-files": [
		".mocharc.json",
		"./src/**/*.ts"
	]
}