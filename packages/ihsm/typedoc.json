{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts", "src/testing.ts"],
	"tsconfig": "tsconfig.typedoc.json",
	"out": ".typedoc-out",
	"plugin": ["typedoc-plugin-markdown"],
	"readme": "none",
	"disableSources": true,
	"excludePrivate": true,
	"excludeInternal": true,
	"excludeExternals": true,
	"hideGenerator": true,
	"sort": ["source-order"],
	"kindSortOrder": ["Class", "Interface", "Enum", "TypeAlias", "Function"],
	"categoryOrder": ["Factory", "Actor configuration", "State machine", "Port", "Testing", "Error", "*"],
	"router": "member",
	"fileExtension": ".mdx",
	"entryFileName": "index",
	"hidePageHeader": true,
	"hidePageTitle": true,
	"hideBreadcrumbs": true,
	"useHTMLAnchors": false,
	"intentionallyNotExported": [
		"OverlappingProtocolKeys",
		"DispatchableMachine",
		"Task",
		"Transition",
		"HsmWithTracing"
	]
}
