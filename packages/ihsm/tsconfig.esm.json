{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"outDir": "./lib/esm",
		"rootDir": "./src",
		"tsBuildInfoFile": "./.tsc/esm.tsbuildinfo",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"types": [],
		"allowJs": false
	},
	"include": ["src/**/*"],
	"exclude": ["src/spec", "src/test-only"]
}
