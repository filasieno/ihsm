{
	"extends": "@istanbuljs/nyc-config-typescript",
	"extension": [".ts"],
	"require": [
		 "ts-node/register/transpile-only"
	],
	"include": [
		"src/"
	],
	"exclude": [
		"node_modules/",
		"coverage/",
		"src/spec"
	],
	"reporter": [
		"text",
		"text-summary",
		"lcov"
	],
	"check-coverage": true,
	"statements": 96,
	"branches": 88,
	"functions": 91,
	"lines": 96
}
