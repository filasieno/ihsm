{
	"extends": "@istanbuljs/nyc-config-typescript",
	"extension": [".ts"],
	"require": [
		 "ts-node/register/transpile-only"
	],
	"include": [
		"src/"
	],
	"exclude": [
		"node_modules/",
		"coverage/",
		"src/spec"
	],
	"reporter": [
		"text",
		"text-summary",
		"lcov"
	],
	"check-coverage": true,
	"statements": 94,
	"branches": 85,
	"functions": 88,
	"lines": 94
}
