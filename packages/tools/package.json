{
	"name": "@ihsm/tools",
	"version": "0.0.22",
	"description": "Development tools for ihsm — static transition table generation and introspection",
	"license": "MIT",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/filasieno/ihsm.git",
		"directory": "packages/tools"
	},
	"bugs": {
		"url": "https://github.com/filasieno/ihsm/issues"
	},
	"homepage": "https://filasieno.github.io/ihsm/",
	"maintainers": [
		"Fabio Nicola Filasieno <fabio.filasieno@users.noreply.github.com>"
	],
	"engines": {
		"node": ">=22"
	},
	"sideEffects": false,
	"dependencies": {
		"ihsm": "0.0.22"
	},
	"devDependencies": {
		"@ihsm/core": "file:../core",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.9.1",
		"chai": "^6.2.2",
		"ihsm": "file:../ihsm",
		"mocha": "^11.7.6",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"files": [
		"lib"
	],
	"main": "./lib/cjs/index.js",
	"module": "./lib/esm/index.js",
	"types": "./lib/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./lib/esm/index.d.ts",
				"default": "./lib/esm/index.js"
			},
			"require": {
				"types": "./lib/cjs/index.d.ts",
				"default": "./lib/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"ihsm-tools": "./lib/cjs/cli.js"
	},
	"scripts": {
		"build": "tsc -b tsconfig.lib.json tsconfig.esm.json && node scripts/finalize-build.mjs",
		"clean": "rm -rf ./lib ./.tsc ./output",
		"test": "TS_NODE_PROJECT=tsconfig.lib.json mocha",
		"typecheck": "tsc -b"
	}
}
