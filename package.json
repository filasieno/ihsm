{
	"author": "Fabio N. Filasieno",
	"browser": "./lib/index.browser.js",
	"bugs": {
		"url": "https://github.com/filasieno/ihsm/issues"
	},
	"contributors": [
		"Roberto Boati"
	],
	"description": "An idiomatic hierarchical state machine package for TypeScript",
	"files": [
		"lib"
	],
	"workspaces": [
		"site"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@istanbuljs/nyc-config-typescript": "^1.0.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.9.1",
		"chai": "^6.2.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"mocha": "^11.7.6",
		"nyc": "^18.0.0",
		"prettier": "^3.8.3",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0"
	},
	"homepage": "https://filasieno.github.io/ihsm/",
	"keywords": [
		"hsm",
		"hierarchical",
		"fsm",
		"state machine",
		"hierarchical state machine",
		"sm",
		"qp",
		"samek",
		"statechart"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"main": "./lib/index.js",
	"name": "ihsm",
	"repository": {
		"type": "git",
		"url": "https://github.com/filasieno/ihsm.git"
	},
	"scripts": {
		"build-browser": "tsc --build tsconfig.browser.json",
		"build-node": "tsc --build tsconfig.json",
		"build": "npm run build-node",
		"clean": "rm -rf ./lib ./.tsc ./.nyc_output ./coverage",
		"coverage": "nyc report --reporter=text-lcov",
		"dist": "npm run build-node && npm run doc",
		"doc": "npm run build -w ihsm-site",
		"doc:preview": "npm run start -w ihsm-site",
		"doc:site": "npm run build -w ihsm-site",
		"verify:doc": "bash scripts/verify-docs-site.sh site/build",
		"lint": "eslint . && prettier --check 'src/**/*.ts' 'tutorials/**/*.ts'",
		"prebuild-browser": "rm -f ./.tsc",
		"prebuild-node": "rm -f ./.tsc",
		"predist": "npm run clean",
		"prettier": "prettier --write 'src/**/*.ts' 'tutorials/**/*.ts'",
		"release:check": "npm run test:all && npm run lint && npm run build && npm run doc && npm run verify:doc",
		"prepublishOnly": "npm run test && npm run build",
		"test": "nyc mocha",
		"test:tutorials": "mocha --config .mocharc.tutorials.json",
		"test:all": "npm test && npm run test:tutorials",
		"typecheck:tutorials": "tsc --project tsconfig.tutorials.json --noEmit"
	},
	"types": "./lib/index.d.ts",
	"version": "0.0.18"
}
