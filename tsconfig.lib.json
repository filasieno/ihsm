{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"outDir": "./lib",
		"rootDir": "./src",
		"tsBuildInfoFile": "./.tsc/lib.tsbuildinfo",
		"lib": ["ES2022"],
		"types": ["node"],
		"allowJs": false
	},
	"include": ["src/**/*"],
	"exclude": ["src/spec"]
}
