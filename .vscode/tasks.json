{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "typecheck",
			"type": "shell",
			"command": "npm run typecheck",
			"options": { "cwd": "${workspaceFolder}/packages/ihsm" },
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "test",
			"type": "shell",
			"command": "npm test",
			"options": { "cwd": "${workspaceFolder}/packages/ihsm" },
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "test:all",
			"type": "shell",
			"command": "npm run test:all",
			"options": { "cwd": "${workspaceFolder}/packages/ihsm" },
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "lint",
			"type": "shell",
			"command": "npm run lint",
			"options": { "cwd": "${workspaceFolder}/packages/ihsm" },
			"problemMatcher": ["$eslint-stylish"]
		}
	]
}
