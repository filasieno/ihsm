{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Mocha: unit tests",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": ["--config", "${workspaceFolder}/.mocharc.json"],
			"cwd": "${workspaceFolder}",
			"env": {
				"TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.lib.json"
			},
			"runtimeArgs": ["--no-experimental-strip-types"],
			"require": ["ts-node/register/transpile-only"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Mocha: tutorial tests",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": ["--config", "${workspaceFolder}/.mocharc.tutorials.json"],
			"cwd": "${workspaceFolder}",
			"env": {
				"TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.tutorials.json"
			},
			"runtimeArgs": ["--no-experimental-strip-types"],
			"require": ["ts-node/register/transpile-only"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Mocha: current unit spec",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": ["${file}"],
			"cwd": "${workspaceFolder}",
			"env": {
				"TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.lib.json"
			},
			"runtimeArgs": ["--no-experimental-strip-types"],
			"require": ["ts-node/register/transpile-only"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Mocha: current tutorial spec",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": ["${file}"],
			"cwd": "${workspaceFolder}",
			"env": {
				"TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.tutorials.json"
			},
			"runtimeArgs": ["--no-experimental-strip-types"],
			"require": ["ts-node/register/transpile-only"]
		}
	]
}
