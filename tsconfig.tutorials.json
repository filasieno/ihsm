{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": false,
		"outDir": "./.tsc/tutorials",
		"rootDir": ".",
		"tsBuildInfoFile": "./.tsc/tutorials.tsbuildinfo",
		"module": "node16",
		"moduleResolution": "node16",
		"types": ["mocha", "node"]
	},
	"include": [
		"tutorials/**/machine.ts",
		"tutorials/**/interactive.ts",
		"tutorials/**/trace-*.ts",
		"tutorials/shared/trace.ts",
		"tutorials/shared/interactive-helpers.ts",
		"tutorials/shared/interactive-types.ts",
		"tutorials/shared/state-names.ts"
	],
	"references": [{ "path": "./tsconfig.lib.json" }]
}
