{
	"compilerOptions": {
		"incremental": true,
		"moduleResolution": "node16",
		"target": "ES2020",
		"module": "node16",
		"allowJs": false,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true,
		"outDir": "./lib",
		"rootDir": "./src",
		"composite": false,
		"tsBuildInfoFile": "./.tsc",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"lib": ["ES2020"],
		"types": ["node"],
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["./lib", "node_modules", "benchmark", "src/spec"]
}
